# Copy to .env and fill in. docker compose reads it automatically.

# --- LLM: any OpenAI-compatible /chat/completions endpoint -------------------
# Evaluated with Google Gemini (gemini-3.8-flash) via its OpenAI-compatible API.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Optional: models to retry a whole question on if the primary is rate-limited or overloaded
# (e.g. gemini-3.6-flash). Leave empty behind your own proxy.
LLM_FALLBACK_MODELS=
# LLM_TIMEOUT_S=60
# LLM_MAX_TOOL_ROUNDS=6
# LLM_MAX_RETRIES=6

# --- SEC EDGAR (only needed for live ingestion) ------------------------------
# SEC asks automated clients to identify themselves: "Name email@domain".
SEC_USER_AGENT="FundamentalsTracker your.name@example.com"

# LOG_LEVEL=INFO
